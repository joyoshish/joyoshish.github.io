<!doctype html>
<html>
  <head>
    {% include head.liquid %}
    {% if site.enable_medium_zoom %}
      <!-- Medium Zoom JS -->
      <script
        defer
        src="{{ site.third_party_libraries.medium_zoom.url.js }}"
        integrity="{{ site.third_party_libraries.medium_zoom.integrity.js }}"
        crossorigin="anonymous"
      ></script>
      <script defer src="{{ '/assets/js/zoom.js' | relative_url | bust_file_cache }}"></script>
    {% endif %}
    {% include scripts/jquery.liquid %}
    {% include scripts/mathjax.liquid %}
    <!-- Distill js -->
    <script src="{{ '/assets/js/distillpub/template.v2.js' | relative_url }}"></script>
    <script src="{{ '/assets/js/distillpub/transforms.v2.js' | relative_url }}"></script>
    <script src="{{ '/assets/js/distillpub/overrides.js' | relative_url }}"></script>
    {% if page._styles %}
      <!-- Page/Post style -->
      <style type="text/css">
        {{ page._styles }}
      </style>
    {% endif %}

        <style>      
      d-article d-contents {
        align-self: start;
        grid-column: 1 / 4;
        grid-row: auto / span 3;
        width: max(70%, 300px);      
        margin-right: 0px;
        margin-top:  0em;
        display: grid;      
        grid-template-columns: 
          minmax(8px, 1fr) [toc] auto 
          minmax(8px, 1fr) [toc-line] 1px
          minmax(32px, 2fr );      
      }
      d-article d-contents nav {      
        grid-column: toc;
      }
      d-article d-contents .figcaption {
        line-height: 1.4em;
      }
      d-article d-contents .toc-line {
        border-right: 1px solid rgba(0, 0, 0, 0.1);
        grid-column: toc-line;
      } 
  
      b i {
        display: inline;
      }
  
      d-article d-contents {      
        align-self: start;
        grid-column: 1 / 4;
        grid-row: auto / span 4;
        justify-self: end;
        margin-top: 0em;
        padding-right: 3em;
        padding-left: 2em;
        border-right: 1px solid rgba(0, 0, 0, 0.1);
      }
  
      d-contents nav h3 {
        margin-top: 0;
        margin-bottom: 1em;
      }
  
      d-contents nav div {
        color: rgba(0, 0, 0, 0.8);
        font-weight: bold;
      }
  
      d-contents nav a {
        color: rgba(0, 0, 0, 0.8);
        border-bottom: none;
        text-decoration: none;
      }
  
      d-contents ul {
        padding-left: 1em;
      }
  
      d-contents nav ul li {
        margin-bottom: 0.25em;
      }
  
      d-contents nav a:hover {
        text-decoration: underline solid rgba(0, 0, 0, 0.6);
      }
  
      d-contents nav ul {
        margin-top: 0;
        margin-bottom: 6px;
      }
  
      d-contents nav > div {
        display: block;
        outline: none;
        margin-bottom: 0.8em;
      }
  
      d-contents nav > div > a {
        font-size: 13px;
        font-weight: 600;
      }
  
      
      d-contents nav > ul > li > a:hover {
        text-decoration: none;
      }

      
    @media (max-width: 1300px) {
      d-article d-contents {      
        justify-self: start;
        align-self: start;        
        grid-column-start: 3;
        grid-column-end: -3;
        padding-bottom: 0.5em;
        margin-bottom: 1em;
        padding-top: 0.5em;            
        width: 100%;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        border-left: 1px solid rgba(0, 0, 0, 0.1);
        border-top: 1px solid rgba(0, 0, 0, 0.1);
        border-bottom-width: 1px;
        border-bottom-style: solid;
        border-bottom-color: rgba(0, 0, 0, 0.1);          
      }
    }

    /* Sticky TOC Styles */
    .sticky-toc {
      position: fixed !important;
      top: 80px;
      right: 20px;
      width: 280px;
      max-height: calc(100vh - 120px);
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 8px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
      z-index: 9999 !important;
      font-size: 0.85em;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
      transform: translateY(10px);
      font-family: inherit;
    }
    
    .sticky-toc.visible {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    
    .sticky-toc-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
      background: rgba(248, 249, 250, 0.9);
      border-radius: 8px 8px 0 0;
    }
    
    .sticky-toc-header h4 {
      margin: 0 !important;
      font-size: 1em;
      font-weight: 600;
      color: #333;
    }
    
    .toc-toggle {
      background: none;
      border: none;
      font-size: 1.2em;
      cursor: pointer;
      color: #666;
      padding: 4px;
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      transition: background-color 0.2s ease, color 0.2s ease;
    }
    
    .toc-toggle:hover {
      color: #333;
      background-color: rgba(0, 0, 0, 0.05);
    }
    
    .sticky-toc-content {
      padding: 12px 16px;
      max-height: calc(100vh - 180px);
      overflow-y: auto;
      transition: max-height 0.3s ease, padding 0.3s ease;
    }
    
    .sticky-toc-content.collapsed {
      max-height: 0 !important;
      padding: 0 16px !important;
      overflow: hidden !important;
    }
    
    .sticky-toc a {
      color: rgba(0, 0, 0, 0.7) !important;
      text-decoration: none !important;
      display: block;
      padding: 6px 8px;
      border-left: 2px solid transparent;
      margin: 2px 0;
      border-radius: 4px;
      transition: all 0.2s ease;
      font-size: 13px;
      line-height: 1.3;
    }
    
    .sticky-toc a:hover {
      color: rgba(0, 0, 0, 0.9) !important;
      background-color: rgba(0, 0, 0, 0.03);
      border-left-color: rgba(0, 0, 0, 0.2);
      text-decoration: none !important;
    }
    
    .sticky-toc a.active {
      color: #0066cc !important;
      background-color: rgba(0, 102, 204, 0.05);
      border-left-color: #0066cc !important;
      font-weight: 500;
    }
    
    .sticky-toc ul {
      margin: 0 !important;
      padding: 0 !important;
      list-style: none !important;
    }
    
    .sticky-toc li {
      margin: 0 !important;
    }
    
    .sticky-toc ul a {
      padding-left: 24px !important;
      font-size: 12px;
    }
    
    .sticky-toc ul ul a {
      padding-left: 40px !important;
      font-size: 11px;
    }
    
    .sticky-toc > div:first-child {
      margin-bottom: 0 !important;
    }
    
    /* Custom scrollbar for sticky TOC */
    .sticky-toc-content::-webkit-scrollbar {
      width: 4px;
    }
    
    .sticky-toc-content::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.05);
      border-radius: 2px;
    }
    
    .sticky-toc-content::-webkit-scrollbar-thumb {
      background: rgba(0, 0, 0, 0.2);
      border-radius: 2px;
    }
    
    .sticky-toc-content::-webkit-scrollbar-thumb:hover {
      background: rgba(0, 0, 0, 0.3);
    }
    
    /* Responsive breakpoints */
    @media (max-width: 1400px) {
      .sticky-toc {
        right: 15px;
        width: 260px;
      }
    }
    
    @media (max-width: 1300px) {
      .sticky-toc {
        display: none !important;
      }
    }
    
    /* Handle fixed navbar */
    body.fixed-top-nav .sticky-toc {
      top: 100px;
    }
    </style>
    
  </head>

  <d-front-matter>
    <script async type="text/json">
      {
            "title": "{{ page.title }}",
            "description": "{{ page.description }}",
            "published": "{{ page.date | date: '%B %d, %Y' }}",
            "authors": [
              {% for author in page.authors %}
              {
                "author": "{{ author.name }}",
                "authorURL": "{{ author.url }}",
                "affiliations": [
                  {
                    "name": "{{ author.affiliations.name }}",
                    "url": "{{ author.affiliations.url }}"
                  }
                ]
              }{% if forloop.last == false %},{% endif %}
              {% endfor %}
            ],
            "katex": {
              "delimiters": [
                {
                  "left": "$",
                  "right": "$",
                  "display": false
                },
                {
                  "left": "$$",
                  "right": "$$",
                  "display": true
                }
              ]
            }
          }
    </script>
  </d-front-matter>

  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="post distill">
      <d-title>
        <h1>{{ page.title }}</h1>
        <p>{{ page.description }}</p>
      </d-title>
      {% if page.authors %}
        <d-byline></d-byline>
      {% endif %}

      <d-article>
        {% if page.toc %}
          <d-contents>
            <nav class="l-text figcaption">
              <h3>Contents</h3>
              <div id="toc-container">
                <!-- TOC will be automatically generated here -->
              </div>
            </nav>
          </d-contents>
        {% endif %}
        
        <!-- Sticky TOC for scrolling -->
        {% if page.toc %}
          <div id="sticky-toc" class="sticky-toc">
            <div class="sticky-toc-header">
              <h4>Contents</h4>
              <button id="toc-toggle" class="toc-toggle" aria-label="Toggle TOC">−</button>
            </div>
            <div id="sticky-toc-container" class="sticky-toc-content">
              <!-- Sticky TOC will be populated here -->
            </div>
          </div>
        {% endif %}
        
        <div id="content-wrapper">
          {{ content }}
        </div>
        
        {% if page.toc %}
        <script>
          (function() {
            'use strict';
            
            // Wait for DOM and other scripts to load
            function initializeTOC() {
              const contentWrapper = document.getElementById('content-wrapper');
              const tocContainer = document.getElementById('toc-container');
              const stickyToc = document.getElementById('sticky-toc');
              const stickyTocContainer = document.getElementById('sticky-toc-container');
              const tocToggle = document.getElementById('toc-toggle');
              
              if (!contentWrapper || !stickyToc) {
                console.log('TOC elements not found, retrying...');
                setTimeout(initializeTOC, 100);
                return;
              }
              
              // Find all headings (h1-h6) in the content
              const headings = contentWrapper.querySelectorAll('h1, h2, h3, h4, h5, h6');
              
              if (headings.length === 0) {
                // Hide TOC if no headings found
                const dContents = document.querySelector('d-contents');
                if (dContents) dContents.style.display = 'none';
                if (stickyToc) stickyToc.style.display = 'none';
                return;
              }
              
              console.log('Found', headings.length, 'headings');
              
              let tocHTML = '';
              let currentLevel = 0;
              let openLists = [];
              
              headings.forEach(function(heading, index) {
                // Generate ID if it doesn't exist
                if (!heading.id) {
                  const slug = heading.textContent.trim()
                    .toLowerCase()
                    .replace(/[^\w\s-]/g, '')
                    .replace(/[\s_-]+/g, '-')
                    .replace(/^-+|-+$/g, '');
                  heading.id = slug || 'heading-' + index;
                }
                
                const level = parseInt(heading.tagName.charAt(1));
                const text = heading.textContent.trim();
                
                // Handle nesting
                if (level > currentLevel) {
                  // Open new nested list(s)
                  while (currentLevel < level) {
                    if (currentLevel === 0) {
                      tocHTML += '<div>';
                    } else {
                      tocHTML += '<ul>';
                    }
                    openLists.push(currentLevel === 0 ? 'div' : 'ul');
                    currentLevel++;
                  }
                } else if (level < currentLevel) {
                  // Close nested list(s)
                  while (currentLevel > level) {
                    const tagType = openLists.pop();
                    tocHTML += '</' + tagType + '>';
                    currentLevel--;
                  }
                }
                
                // Add the TOC item
                if (level === 1 || (level === 2 && openLists.length === 1)) {
                  tocHTML += '<div><a href="#' + heading.id + '">' + text + '</a></div>';
                } else {
                  tocHTML += '<li><a href="#' + heading.id + '">' + text + '</a></li>';
                }
              });
              
              // Close any remaining open lists
              while (openLists.length > 0) {
                const tagType = openLists.pop();
                tocHTML += '</' + tagType + '>';
              }
              
              // Populate both TOCs
              if (tocContainer) {
                tocContainer.innerHTML = tocHTML;
              }
              if (stickyTocContainer) {
                stickyTocContainer.innerHTML = tocHTML;
              }
              
              // Add smooth scrolling to both TOCs
              const allTocLinks = document.querySelectorAll('#toc-container a[href^="#"], #sticky-toc-container a[href^="#"]');
              allTocLinks.forEach(function(link) {
                link.addEventListener('click', function(e) {
                  e.preventDefault();
                  const targetId = this.getAttribute('href').substring(1);
                  const targetElement = document.getElementById(targetId);
                  if (targetElement) {
                    // Account for fixed header
                    const offset = document.body.classList.contains('fixed-top-nav') ? 80 : 20;
                    const elementPosition = targetElement.offsetTop - offset;
                    
                    window.scrollTo({
                      top: elementPosition,
                      behavior: 'smooth'
                    });
                  }
                });
              });
              
              // Sticky TOC functionality
              let isVisible = false;
              let isCollapsed = false;
              
              function updateActiveSection() {
                const scrollPos = window.pageYOffset + 120;
                let activeHeading = null;
                
                // Find the currently active heading
                for (let i = headings.length - 1; i >= 0; i--) {
                  if (headings[i].offsetTop <= scrollPos) {
                    activeHeading = headings[i];
                    break;
                  }
                }
                
                // Update active states in sticky TOC
                const stickyLinks = stickyTocContainer.querySelectorAll('a');
                stickyLinks.forEach(link => link.classList.remove('active'));
                
                if (activeHeading && stickyTocContainer) {
                  const activeLink = stickyTocContainer.querySelector('a[href="#' + activeHeading.id + '"]');
                  if (activeLink) {
                    activeLink.classList.add('active');
                  }
                }
              }
              
              function updateStickyTocVisibility() {
                const originalToc = document.querySelector('d-contents');
                if (!originalToc || !stickyToc) return;
                
                const originalTocRect = originalToc.getBoundingClientRect();
                const shouldShow = originalTocRect.bottom < -50;
                
                if (shouldShow && !isVisible) {
                  stickyToc.classList.add('visible');
                  isVisible = true;
                  console.log('Showing sticky TOC');
                } else if (!shouldShow && isVisible) {
                  stickyToc.classList.remove('visible');
                  isVisible = false;
                  console.log('Hiding sticky TOC');
                }
              }
              
              // Toggle functionality
              if (tocToggle) {
                tocToggle.addEventListener('click', function(e) {
                  e.preventDefault();
                  e.stopPropagation();
                  isCollapsed = !isCollapsed;
                  const stickyTocContent = document.getElementById('sticky-toc-container');
                  if (isCollapsed) {
                    stickyTocContent.classList.add('collapsed');
                    tocToggle.textContent = '+';
                    tocToggle.setAttribute('aria-label', 'Expand TOC');
                  } else {
                    stickyTocContent.classList.remove('collapsed');
                    tocToggle.textContent = '−';
                    tocToggle.setAttribute('aria-label', 'Collapse TOC');
                  }
                });
              }
              
              // Optimized scroll event listener
              let ticking = false;
              function onScroll() {
                if (!ticking) {
                  requestAnimationFrame(function() {
                    updateStickyTocVisibility();
                    updateActiveSection();
                    ticking = false;
                  });
                  ticking = true;
                }
              }
              
              window.addEventListener('scroll', onScroll, { passive: true });
              
              // Initial calls
              setTimeout(function() {
                updateStickyTocVisibility();
                updateActiveSection();
              }, 100);
              
              console.log('TOC initialized successfully');
            }
            
            // Initialize when DOM is ready
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', initializeTOC);
            } else {
              initializeTOC();
            }
          })();
        </script>
        {% endif %}
      </d-article>

      <d-appendix>
        <d-footnote-list></d-footnote-list>
        <d-citation-list></d-citation-list>
      </d-appendix>

      <d-bibliography src="{{ page.bibliography | prepend: '/assets/bibliography/' | relative_url }}"></d-bibliography>

      {% if site.disqus_shortname and page.disqus_comments %}{% include disqus.liquid %}{% endif %}
      {% if site.giscus.repo and page.giscus_comments %}
        {% include giscus.liquid %}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}
    {% include scripts/bootstrap.liquid %}
    {% include scripts/analytics.liquid %}
    {% include scripts/progressBar.liquid %}
  </body>
</html>